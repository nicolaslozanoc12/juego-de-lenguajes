{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juego-de-lenguajes.local/contracts/response.schema.json",
  "title": "Respuesta de combate",
  "description": "Respuesta exitosa o semanticamente invalida de un turno.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contrato_version", "valido", "golpe", "accion", "error",
    "dano_enemigo", "dano_jugador", "enemigo_accion",
    "vida_jugador", "vida_enemigo", "estado", "cintas", "cabezales"
  ],
  "properties": {
    "contrato_version": { "const": "1.0" },
    "valido": { "type": "boolean" },
    "golpe": { "type": ["string", "null"] },
    "accion": { "enum": ["A", "D", "C", "E"] },
    "error": { "type": ["string", "null"] },
    "dano_enemigo": { "type": "integer", "minimum": 0 },
    "dano_jugador": { "type": "integer", "minimum": 0 },
    "enemigo_accion": {
      "enum": ["ATAQUE_RAPIDO", "ATAQUE_PESADO", "BLOQUEO", "CASTIGO"]
    },
    "vida_jugador": { "type": "integer", "minimum": 0, "maximum": 100 },
    "vida_enemigo": { "type": "integer", "minimum": 0, "maximum": 100 },
    "estado": { "enum": ["JUGANDO", "VICTORIA", "DERROTA"] },
    "cintas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cinta1", "cinta2", "cinta3"],
      "properties": {
        "cinta1": { "type": "array", "items": { "enum": ["A", "D", "C", "E"] } },
        "cinta2": {
          "type": "array",
          "prefixItems": [
            { "type": "string", "pattern": "^[0-3]$" },
            { "type": "string", "pattern": "^[0-3]$" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "cinta3": {
          "type": "array",
          "items": {
            "enum": ["ATAQUE_RAPIDO", "ATAQUE_PESADO", "BLOQUEO", "CASTIGO"]
          }
        }
      }
    },
    "cabezales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L", "R", "S"],
      "properties": {
        "L": { "type": "integer", "minimum": 0 },
        "R": { "const": 0 },
        "S": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
