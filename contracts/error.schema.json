{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juego-de-lenguajes.local/contracts/error.schema.json",
  "title": "Error de protocolo",
  "type": "object",
  "additionalProperties": false,
  "required": ["contrato_version", "valido", "error"],
  "properties": {
    "contrato_version": { "const": "1.0" },
    "valido": { "const": false },
    "error": { "type": "string", "minLength": 1 }
  }
}
