theme_override_font_sizes/font_size = 16
text = "4. Seis por Derecho  (Parry defensivo)
    Teclas:  J  K  L  J  + Espacio   (T S D T F)
    → Escudo armónico que bloquea los proyectiles del turno.

5. Zumbe y Zumbe  (Esquive rítmico)
    Teclas:  K  L  K  L  + Espacio   (S D S D F)
    → Postura evasiva que anula los disparos de ese turno.

6. Tonada de Sabana  (Calma)
    Teclas:  J  I  K  J  + Espacio   (T M S T F)
    → Nota serena que reduce la Furia de El Silbón."
autowrap_mode = 3

