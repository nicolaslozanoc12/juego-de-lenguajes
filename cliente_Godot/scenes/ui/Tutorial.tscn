theme_override_font_sizes/font_size = 16
text = "1. Golpe de Gabán  (15 daño)
    Teclas:  J  L  L  J  + Espacio   (T D D T F)
    → Proyectil único veloz hacia tu dirección.

2. Contrapunteo Libre  (25 daño)
    Teclas:  J  L  (K  L  J)+  + Espacio   (T D (S D T)+ F)
    → Ráfaga de 3 notas consecutivas. Ej: J L K L J

3. Golpe de Pajarillo  (30 daño)
    Teclas:  I  K  L  I  + Espacio   (M S D M F)
    → Abanico triple de notas de alto impacto."
autowrap_mode = 3

