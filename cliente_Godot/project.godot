; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be edited easily using any text editor.

config_version=5

[application]

config/name="El Cuatro Llanero - Juego de Lenguajes"
config/description="Juego 2D isometrico de combate musical con ANTLR4 y Maquina de Turing"
run/main_scene="res://scenes/combat/CombatArena.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
