        <mxCell id="CLI_INPUT" parent="CLIENT_BOX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" value="&lt;b&gt;1. Entrada y Audio del Cuatro&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#475569&#39;&gt;• Captura teclas (A, S, D, W, Espacio)&lt;br&gt;• Suena el acorde al instante en local&lt;br&gt;• Acumula la secuencia: &quot;TDDTF&quot;&lt;/font&gt;" vertex="1">
