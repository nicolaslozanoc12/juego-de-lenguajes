        <mxCell id="MSG_REQ" parent="NET_CHANNEL" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#1f2937;fontSize=11;fontFamily=monospace;align=left;spacing=6;" value="&lt;b&gt;Petición (Godot → Python):&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#15803d&#39;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;secuencia&quot;: &quot;TDDTF&quot;&lt;br&gt;}&lt;/font&gt;" vertex="1">
