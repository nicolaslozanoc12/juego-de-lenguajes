<mxfile host="Electron" modified="2026-11-05T22:50:00.000Z" agent="Antigravity Architect" version="21.6.8" type="device">
  <diagram id="ArquitecturaSimpleClienteServidor" name="Arquitectura Simple en Capas">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============================================== -->
        <!-- 1. CLIENTE: GODOT ENGINE (FRONTEND)            -->
        <!-- ============================================== -->
        <mxCell id="CLIENT_BOX" value="CLIENTE: Godot Engine 4 (Interfaz y Juego)" style="swimlane;whiteSpace=wrap;html=1;startSize=35;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#0369a1;fontStyle=1;fontSize=14;rounded=1;arcSize=10;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="320" height="520" as="geometry" />
        </mxCell>

        <mxCell id="CLI_INPUT" value="&lt;b&gt;1. Entrada y Audio del Cuatro&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;• Captura teclas (A, S, D, W, Espacio)&lt;br&gt;• Suena el acorde al instante en local&lt;br&gt;• Acumula la secuencia: &quot;TDDTF&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="CLIENT_BOX">
          <mxGeometry x="25" y="55" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="CLI_NET" value="&lt;b&gt;2. Cliente de Red (Socket)&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;• Al presionar &#39;F&#39; (Frenao), envía la cadena&lt;br&gt;• Recibe el resultado y las cintas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="CLIENT_BOX">
          <mxGeometry x="25" y="180" width="270" height="85" as="geometry" />
        </mxCell>

        <mxCell id="CLI_UI" value="&lt;b&gt;3. Vista Isométrica y HUD&lt;/b&gt;&lt;br&gt;&lt;font color='#475569'&gt;• Muestra animaciones de ataque/defensa&lt;br&gt;• Barras de vida de llanero y enemigo&lt;br&gt;• &lt;b&gt;Dibuja las 3 cintas de Turing en pantalla&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#38bdf8;fontColor=#0f172a;fontSize=12;align=left;spacing=10;" vertex="1" parent="CLIENT_BOX">
          <mxGeometry x="25" y="300" width="270" height="100" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- 2. CANAL DE COMUNICACIÓN (SOCKET LOCAL)       -->
        <!-- ============================================== -->
        <mxCell id="NET_CHANNEL" value="CANAL LOCAL (Socket / JSON)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#854d0e;fontStyle=1;fontSize=12;rounded=1;arcSize=8;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="220" height="260" as="geometry" />
        </mxCell>

        <mxCell id="MSG_REQ" value="&lt;b&gt;Petición (Godot → Python):&lt;/b&gt;&lt;br&gt;&lt;font color='#15803d'&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;secuencia&quot;: &quot;TDDTF&quot;&lt;br&gt;}&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#1f2937;fontSize=11;fontFamily=monospace;align=left;spacing=6;" vertex="1" parent="NET_CHANNEL">
          <mxGeometry x="15" y="45" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="MSG_RES" value="&lt;b&gt;Respuesta (Python → Godot):&lt;/b&gt;&lt;br&gt;&lt;font color='#0369a1'&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;valido&quot;: true,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;golpe&quot;: &quot;Gaban&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;enemigo&quot;: &quot;Contraataque&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;cintas&quot;: [...]&lt;br&gt;}&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;strokeColor=#ca8a04;fontColor=#1f2937;fontSize=10;fontFamily=monospace;align=left;spacing=6;" vertex="1" parent="NET_CHANNEL">
          <mxGeometry x="15" y="140" width="190" height="105" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- 3. SERVIDOR PYTHON (ARQUITECTURA DE 2 CAPAS)   -->
        <!-- ============================================== -->
        <mxCell id="SERVER_BOX" value="SERVIDOR: Python 3 (Arquitectura en Capas)" style="swimlane;whiteSpace=wrap;html=1;startSize=35;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#166534;fontStyle=1;fontSize=14;rounded=1;arcSize=10;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="80" width="430" height="520" as="geometry" />
        </mxCell>

        <!-- CAPA 1: CONECTIVIDAD -->
        <mxCell id="SRV_LAYER_NET" value="CAPA 1: CONECTIVIDAD / RED" style="swimlane;whiteSpace=wrap;html=1;startSize=25;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontStyle=1;fontSize=11;rounded=1;" vertex="1" parent="SERVER_BOX">
          <mxGeometry x="25" y="55" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="SRV_SOCKET" value="&lt;b&gt;Servidor Socket / WebSocket&lt;/b&gt;&lt;br&gt;&lt;font color='#374151'&gt;• Recibe el JSON con la secuencia del llanero&lt;br&gt;• Llama a la capa de lógica y devuelve la respuesta a Godot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22c55e;fontColor=#111827;fontSize=11;align=left;spacing=8;" vertex="1" parent="SRV_LAYER_NET">
          <mxGeometry x="15" y="32" width="350" height="50" as="geometry" />
        </mxCell>

        <!-- CAPA 2: LÓGICA / COMPONENTES FORMALES -->
        <mxCell id="SRV_LAYER_LOGIC" value="CAPA 2: LÓGICA Y COMPONENTES FORMALES" style="swimlane;whiteSpace=wrap;html=1;startSize=25;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontStyle=1;fontSize=11;rounded=1;" vertex="1" parent="SERVER_BOX">
          <mxGeometry x="25" y="170" width="380" height="325" as="geometry" />
        </mxCell>

        <mxCell id="COMP_ANTLR" value="&lt;b&gt;Componente 1: Parser ANTLR4 (El Llanero)&lt;/b&gt;&lt;br&gt;&lt;font color='#334155'&gt;• Valida la gramática del cuatro (&lt;i&gt;CuatroLlanero.g4&lt;/i&gt;)&lt;br&gt;• Identifica el golpe: &lt;b&gt;Gaban, Pajarillo, Seis, Tonada, etc.&lt;/b&gt;&lt;br&gt;• Si la secuencia falla, emite &lt;b&gt;Error Sintáctico (Desafinado)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;align=left;spacing=8;" vertex="1" parent="SRV_LAYER_LOGIC">
          <mxGeometry x="15" y="35" width="350" height="75" as="geometry" />
        </mxCell>

        <mxCell id="COMP_TURING" value="&lt;b&gt;Componente 2: Máquina de Turing Multicinta (El Enemigo)&lt;/b&gt;&lt;br&gt;&lt;font color='#334155'&gt;• &lt;b&gt;Cinta 1:&lt;/b&gt; Historial de acciones del jugador (A, D, C, E)&lt;br&gt;• &lt;b&gt;Cinta 2:&lt;/b&gt; Furia del enemigo / Detector de spam&lt;br&gt;• &lt;b&gt;Cinta 3:&lt;/b&gt; Decisión táctica: &lt;i&gt;Ataque, Bloqueo o Castigo&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;fontColor=#6b21a8;fontSize=11;align=left;spacing=8;" vertex="1" parent="SRV_LAYER_LOGIC">
          <mxGeometry x="15" y="125" width="350" height="85" as="geometry" />
        </mxCell>

        <mxCell id="COMP_RESOLUCION" value="&lt;b&gt;Controlador de Combate Simple&lt;/b&gt;&lt;br&gt;&lt;font color='#334155'&gt;• Cruza la acción del llanero vs la decisión de la MT&lt;br&gt;• Calcula el daño a restar y prepara el JSON final&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#9a3412;fontSize=11;align=left;spacing=8;" vertex="1" parent="SRV_LAYER_LOGIC">
          <mxGeometry x="15" y="225" width="350" height="65" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
        <!-- CONECTORES Y FLECHAS DE FLUJO                  -->
        <!-- ============================================== -->
        <!-- 1. Enviar secuencia a Socket -->
        <mxCell id="F_SEND" value="1. Envía secuencia al pulsar &#39;F&#39;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="CLI_NET" target="MSG_REQ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. Socket entrega a Servidor Python -->
        <mxCell id="F_SOCKET_IN" value="2. Recibe JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="MSG_REQ" target="SRV_SOCKET">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="660" y="295" />
              <mxPoint x="660" y="192" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. Red pasa a ANTLR -->
        <mxCell id="F_TO_ANTLR" value="3. Valida cadena con ANTLR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="SERVER_BOX" source="SRV_SOCKET" target="COMP_ANTLR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. ANTLR pasa a Turing -->
        <mxCell id="F_TO_TURING" value="4. Entrega golpe a la Cinta 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#7e22ce;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="SRV_LAYER_LOGIC" source="COMP_ANTLR" target="COMP_TURING">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. Turing pasa a Resolución -->
        <mxCell id="F_TO_RES" value="5. Decide contraataque" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#c2410c;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="SRV_LAYER_LOGIC" source="COMP_TURING" target="COMP_RESOLUCION">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. Retorno de Capa Lógica a Red -->
        <mxCell id="F_BACK_NET" value="6. Retorna resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;fontColor=#15803d;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="SERVER_BOX" source="COMP_RESOLUCION" target="SRV_SOCKET">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="405" y="428" />
              <mxPoint x="405" y="112" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 7. Servidor responde a Godot -->
        <mxCell id="F_RES_OUT" value="7. Envía respuesta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="SRV_SOCKET" target="MSG_RES">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670" y="202" />
              <mxPoint x="670" y="403" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="F_RES_GODOT" value="8. Actualiza HUD y Cintas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="MSG_RES" target="CLI_UI">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="403" />
